# Шаблон окружения. Скопируйте в .env:  cp .env.example .env
# Реальный .env в репозиторий не попадает (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=ai_buddy
DATABASE_URL=postgresql+psycopg://avito:avito@postgres:5432/ai_buddy

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LLM (OpenAI-совместимый API) ---
# Пусто = оффлайн-стаб FakeLLM, прототип работает без ключа.
# Ключ в репозиторий не коммитим: эксперты создают свой по инструкции в README
# (раздел «Внешние API») и вписывают его только в локальный .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5-72b-instruct

# --- MCP-сервер инструментов (отдельный процесс) ---
MCP_SERVER_URL=http://mcp:8001
